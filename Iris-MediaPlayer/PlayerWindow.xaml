<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Iris_MediaPlayer.PlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Iris_MediaPlayer.Views"
    Title="Iris">

    <!--
        Standalone player, shown when Windows opens a video file with Iris (like VLC).
        Just the player: no navigation rail, library or top bar.
    -->
    <Grid Background="{StaticResource IrisBackgroundBrush}" AllowDrop="True"
          DragOver="Root_DragOver" Drop="Root_Drop">
        <views:PlayerView x:Name="Player" />
    </Grid>
</Window>
