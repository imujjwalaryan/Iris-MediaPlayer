<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Iris_MediaPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Iris_MediaPlayer.Views"
    Title="Iris">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="AppNavigation"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True"
                    IsPaneToggleButtonVisible="False"
                    IsPaneOpen="False"
                    CompactPaneLength="68"
                    OpenPaneLength="68"
                    PaneDisplayMode="LeftCompact"
                    SelectionChanged="AppNavigation_SelectionChanged"
                    Loaded="AppNavigation_Loaded"
                    Background="Transparent"
                    AllowDrop="True"
                    DragEnter="App_DragEnter"
                    DragOver="App_DragOver"
                    DragLeave="App_DragLeave"
                    Drop="App_Drop">
        <NavigationView.Resources>
            <!-- pane (the left rail) -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />

            <!-- content area: no fill, no border, no built-in corner -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="Home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Videos" Tag="LibraryVideos">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Video" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Folders" Tag="LibraryFolders">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Collections" Tag="LibraryCollections">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Jellyfin" Tag="Jellyfin">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Globe" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Border x:Name="RoundedContentSurface"
                Margin="0,0,8,8"
                CornerRadius="16"
                Background="{StaticResource IrisBackgroundBrush}"
                BorderBrush="{StaticResource IrisStrokeBrush}"
                BorderThickness="1">
            <Grid x:Name="ContentRoot" SizeChanged="ContentRoot_SizeChanged">
                <!-- One section is visible at a time; see MainWindow.ShowSection. -->
                <views:HomeView x:Name="HomePage" />
                <views:LibraryView x:Name="LibraryPage" Visibility="Collapsed" />
                <views:PlaceholderView x:Name="PlaceholderPage" Visibility="Collapsed" />

                <!--
                    App-wide top bar: the only search box and the only "Open video" button.
                    It floats over the pages (which leave room for it) so Home's artwork can run behind it.
                -->
                <Grid x:Name="TopBar" VerticalAlignment="Top" Height="{StaticResource IrisTopBarHeight}"
                      Padding="32,16,24,0" ColumnSpacing="12">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E60F1115" Offset="0" />
                            <GradientStop Color="#990F1115" Offset="0.6" />
                            <GradientStop Color="#000F1115" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="460" VerticalAlignment="Top"
                                    PlaceholderText="Search videos and folders" QueryIcon="Find"
                                    TextMemberPath="Title"
                                    TextChanged="SearchBox_TextChanged"
                                    QuerySubmitted="SearchBox_QuerySubmitted">
                        <AutoSuggestBox.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
                        </AutoSuggestBox.KeyboardAccelerators>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="0,6" Spacing="2">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource IrisCaptionTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="OpenVideo_Click" ToolTipService.ToolTip="Play a video file without adding it to your library">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="Open video" />
                        </StackPanel>
                    </Button>
                </Grid>

                <views:PlayerView x:Name="PlayerPage" Visibility="Collapsed" />

                <Border x:Name="DropOverlay" Visibility="Collapsed" Margin="24" CornerRadius="20"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                        Background="#E51A1D29" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE8E5;" FontSize="42" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Drop a video to play instantly" Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="It won’t be added to your folders or library."
                                   HorizontalAlignment="Center" Opacity="0.72" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </NavigationView>
</Window>
