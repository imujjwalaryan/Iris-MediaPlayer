<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Iris_MediaPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Iris">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="AppNavigation"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True"
                    IsPaneToggleButtonVisible="False"
                    IsPaneOpen="False"
                    CompactPaneLength="68"
                    OpenPaneLength="68"
                    PaneDisplayMode="LeftCompact"
                    SelectionChanged="AppNavigation_SelectionChanged"
                    Loaded="AppNavigation_Loaded"
                    Background="Transparent"
                    AllowDrop="True"
                    DragEnter="App_DragEnter"
                    DragOver="App_DragOver"
                    DragLeave="App_DragLeave"
                    Drop="App_Drop">
        <NavigationView.Resources>
            <!-- pane (the left rail) -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />

            <!-- content area: no fill, no border, no built-in corner -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="Home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Videos" Tag="LibraryVideos">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Video" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Folders" Tag="LibraryFolders">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Collections" Tag="LibraryCollections">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Jellyfin" Tag="Jellyfin">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Globe" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Border x:Name="RoundedContentSurface"
            Margin="0,0,8,8"
            CornerRadius="16"
            Background="#FF0F1115"
            BorderBrush="#14FFFFFF"
            BorderThickness="1">
            <Grid x:Name="ContentRoot" SizeChanged="ContentRoot_SizeChanged">
                <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="22" Padding="28,24,28,32">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="PageTitle" Text="Home" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock x:Name="PageSubtitle" Text="Welcome to Iris — your media, gathered in one place." Opacity="0.72" />
                            </StackPanel>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Width="300" PlaceholderText="Search your library"
                                 VerticalAlignment="Center" TextChanged="SearchBox_TextChanged">
                                <TextBox.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F" Modifiers="Control" />
                                </TextBox.KeyboardAccelerators>
                            </TextBox>
                            <Button Grid.Column="2" Content="Open video" Click="OpenVideo_Click" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Content="Add folder" Click="AddFolder_Click" VerticalAlignment="Center" />
                        </Grid>

                        <Border x:Name="UpNextCard" Height="280" CornerRadius="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52*" />
                                    <ColumnDefinition Width="48*" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="FeaturedImage" Grid.Column="0" Stretch="UniformToFill" Opacity="0.4"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                <Border Grid.ColumnSpan="2" CornerRadius="16">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#80392F54" Offset="0" />
                                            <GradientStop Color="#70202433" Offset="0.48" />
                                            <GradientStop Color="#80171A23" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid Grid.ColumnSpan="2" Padding="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="12" MaxWidth="540">
                                        <TextBlock Text="UP NEXT" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               FontWeight="SemiBold" CharacterSpacing="160" />
                                        <TextBlock x:Name="FeaturedTitle" Text="Your next favorite starts here"
                                               Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="FeaturedSubtitle"
                                               Text="Add a folder and Iris will discover your movies and shows."
                                               TextWrapping="Wrap" Opacity="0.78" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                            <Button x:Name="FeaturedPlayButton" Content="Play" Click="FeaturedPlay_Click"
                                                IsEnabled="False" />
                                            <Button Content="Browse library" Click="LibraryShortcut_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="1" />
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Continue watching" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="ContinueEmpty" Grid.Column="1"
                                       Text="Playback progress will be added next" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Opacity="0.62" />
                            </Grid>
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ContinueItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding FilePath}" Click="MediaCard_Click" Padding="0" BorderThickness="0"
                                                Background="Transparent" Width="220" HorizontalContentAlignment="Stretch">
                                                <StackPanel Spacing="7">
                                                    <Border Height="120" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE714;" FontSize="30" Opacity="0.35" />
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                            <Border VerticalAlignment="Bottom" Padding="12" Background="#B8000000">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="10">
                                <TextBlock Text="Recently played" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="RecentlyPlayedEmpty"
                                       Text="Nothing played yet. Play a title from your library and it will appear here."
                                       TextWrapping="Wrap" Opacity="0.7" />
                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="RecentItems">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding FilePath}" Click="MediaCard_Click" Padding="0" BorderThickness="0"
                                                    Background="Transparent" Width="112">
                                                    <StackPanel Spacing="6">
                                                        <Border Height="120" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                            <Grid>
                                                                <FontIcon Glyph="&#xE714;" FontSize="24" Opacity="0.35" />
                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                                <Border VerticalAlignment="Bottom" Padding="8" Background="#B8000000">
                                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.68" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="10">
                                <Grid>
                                    <TextBlock Text="Your folders" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <Button Content="Add" Click="AddFolder_Click" HorizontalAlignment="Right" />
                                </Grid>
                                <ListView x:Name="FolderList" MaxHeight="180" SelectionMode="None"
                                      IsItemClickEnabled="False">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="10" Padding="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE8B7;" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MediaCountLabel}" FontSize="12" Opacity="0.65" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="&#xE74D;" Tag="{Binding Path}"
                                                    Click="RemoveFolder_Click" ToolTipService.ToolTip="Remove folder" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="FoldersEmpty" Text="Add folders to build your library."
                                       Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Padding="14,10" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Drop a video anywhere in Iris or choose Open video for instant playback."
                                       VerticalAlignment="Center" Opacity="0.72" />
                                <Button Grid.Column="1" Content="Open video" Click="OpenVideo_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="LibraryView" Visibility="Collapsed" Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="LibraryTitle" Text="Library" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="LibrarySummary" Text="Add folders to discover media on this device." Opacity="0.7" />
                        </StackPanel>
                        <TextBox x:Name="LibrarySearchBox" Grid.Column="1" Width="300"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             PlaceholderText="Search your library" TextChanged="SearchBox_TextChanged" />
                        <Button Grid.Column="2" Content="Open video" Click="OpenVideo_Click" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Content="Add folder" Click="AddFolder_Click" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,20,0,0" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="FolderBrowserPanel" Grid.Row="0" Spacing="8" Visibility="Collapsed">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="FolderBrowserBackButton" Content="Back" Click="FolderBrowserBack_Click" Visibility="Collapsed" />
                                <TextBlock x:Name="FolderBreadcrumb" Grid.Column="1" VerticalAlignment="Center"
                                       Text="Choose a library folder to browse." Opacity="0.72" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <ItemsControl x:Name="FolderTiles" MaxHeight="152">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Path}" Click="Subfolder_Click" Padding="12,8" Margin="0,0,8,0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <FontIcon Glyph="&#xE8B7;" VerticalAlignment="Center" />
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                    <TextBlock Text="{Binding MediaCountLabel}" FontSize="11" Opacity="0.65" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="FolderBrowserEmpty" Text="No library folders yet. Add a folder to browse its videos."
                                   Visibility="Collapsed" Opacity="0.65" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid x:Name="CollectionsPanel" Grid.Row="0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CollectionsBackButton" Content="Collections" Click="CollectionsBack_Click" Visibility="Collapsed" />
                                <StackPanel x:Name="CollectionHeading" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Your collections" FontWeight="SemiBold" />
                                    <TextBlock Text="Playlists stay independent of your folder layout." FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <TextBlock x:Name="SelectedCollectionName" Grid.Column="1" VerticalAlignment="Center"
                                       FontSize="18" FontWeight="SemiBold" Visibility="Collapsed" />
                                <TextBlock x:Name="SelectedCollectionCount" Grid.Column="2" VerticalAlignment="Center"
                                       Margin="0,0,10,0" Opacity="0.65" Visibility="Collapsed" />
                                <Button x:Name="AddCollectionVideosButton" Grid.Column="3" Content="Edit videos" Click="AddCollectionVideos_Click" Visibility="Collapsed" />
                                <Button x:Name="CreateCollectionButton" Grid.Column="4" Content="New collection" Click="CreateCollection_Click" />
                                <Button x:Name="DeleteCollectionButton" Grid.Column="4" Content="Delete" Click="DeleteCollection_Click" Visibility="Collapsed" />
                            </Grid>
                            <ItemsControl x:Name="CollectionTiles" Grid.Row="1" MaxHeight="152" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="CollectionTile_Click" Padding="12,8" Margin="0,0,8,0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <FontIcon Glyph="&#xE8D6;" VerticalAlignment="Center" />
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                                    <TextBlock Text="{Binding VideoCountLabel}" FontSize="11" Opacity="0.65" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="CollectionEmpty" Grid.Row="1"
                                   Text="No collections yet. Create one, then add videos from anywhere in your library."
                                   Visibility="Collapsed" Opacity="0.65" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <ItemsRepeater x:Name="LibraryItems" HorizontalAlignment="Stretch">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="300" MinItemHeight="326"
                                                   ItemsStretch="Fill" MinColumnSpacing="16" MinRowSpacing="16" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding FilePath}" Click="MediaCard_Click" Padding="0"
                                            BorderThickness="0" Background="Transparent"
                                            HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                                                <Border Padding="12" CornerRadius="12"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <Grid RowSpacing="9">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="170" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border CornerRadius="8"
                                                        Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                                                            <Grid>
                                                                <FontIcon Glyph="&#xE714;" FontSize="30" Opacity="0.35" />
                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="16"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           MaxLines="2" />
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Resolution}" FontSize="12" />
                                                            <TextBlock Text="·" Opacity="0.55" />
                                                            <TextBlock Text="{Binding Bitrate}" FontSize="12" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="3" Text="{Binding Subtitle}" FontSize="12"
                                                           Opacity="0.68" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <TextBlock x:Name="LibraryEmpty" Text="Your library is empty. Add a folder to scan for video files."
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                               TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="PlaceholderView" Visibility="Collapsed" Padding="36">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="440">
                        <TextBlock x:Name="PlaceholderTitle" Text="Coming later" Style="{StaticResource TitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                        <TextBlock x:Name="PlaceholderDescription" Text="This area will be built in a later Iris milestone."
                               TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="PlayerView" Visibility="Collapsed" Background="#0D0F15" CornerRadius="15"
                  PointerMoved="PlayerView_PointerMoved" KeyDown="PlayerView_KeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" Invoked="PlayerKeyboardAccelerator_Invoked" />
                        <KeyboardAccelerator Key="F" Invoked="PlayerKeyboardAccelerator_Invoked" />
                        <KeyboardAccelerator Key="Space" Invoked="PlayerKeyboardAccelerator_Invoked" />
                    </Grid.KeyboardAccelerators>
                    <Grid x:Name="VideoHost" Grid.Row="1" Background="Transparent" SizeChanged="VideoHost_SizeChanged"
                      PointerMoved="PlayerView_PointerMoved">
                        <SwapChainPanel x:Name="VideoPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    PointerMoved="PlayerView_PointerMoved" />
                        <StackPanel x:Name="PlayerStatus" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="10" IsHitTestVisible="False">
                            <ProgressRing x:Name="PlaybackProgress" IsActive="False" Width="36" Height="36" />
                            <TextBlock x:Name="PlaybackStatusText" Text="Choose a video to start playback."
                                   HorizontalAlignment="Center" Opacity="0.76" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="PlayerHeaderBar" VerticalAlignment="Top" Padding="18,12" CornerRadius="15,15,0,0"
                      Background="#B3000000">
                        <TextBlock x:Name="PlayerTitle" Text="Ready to play" VerticalAlignment="Center"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Border x:Name="PlayerControlsBar" Grid.Row="2" VerticalAlignment="Bottom" Padding="12,6,12,6"
                        CornerRadius="0,0,15,15" SizeChanged="PlayerControlsBar_SizeChanged">
                        <Border.Resources>
                            <Style x:Key="PlayerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                <Setter Property="Width" Value="36" />
                                <Setter Property="Height" Value="36" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Border.Resources>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00101010" Offset="0" />
                                <GradientStop Color="#A6000000" Offset="0.42" />
                                <GradientStop Color="#E6000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid x:Name="ControlsRow" ColumnSpacing="12" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="LeftControlsGroup" Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center">
                                <Button x:Name="PlayPauseButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="PlayPause_Click" IsEnabled="False"
                                    ToolTipService.ToolTip="Play or pause">
                                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16" />
                                </Button>
                                <Button x:Name="SeekBackwardButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="SeekBackward_Click" IsEnabled="False"
                                    ToolTipService.ToolTip="Back 10 seconds">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                        <TextBlock Text="10" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SeekForwardButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="SeekForward_Click" IsEnabled="False"
                                    ToolTipService.ToolTip="Forward 10 seconds">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="10" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MuteButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="MuteButton_Click" IsEnabled="False"
                                    ToolTipService.ToolTip="Mute or unmute">
                                    <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16" />
                                </Button>
                                <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="100" Value="100"
                                    VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                                <StackPanel x:Name="TimeGroup" Orientation="Horizontal" Spacing="4" MinWidth="104"
                                        Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="12" />
                                    <TextBlock x:Name="TimeSeparatorText" Text="/" FontSize="12" Opacity="0.5" />
                                    <TextBlock x:Name="DurationText" Text="0:00" FontSize="12" Opacity="0.72" />
                                </StackPanel>
                            </StackPanel>

                            <Grid x:Name="SeekBarHost" Grid.Column="1" Height="32" VerticalAlignment="Center"
                              PointerMoved="SeekBarHost_PointerMoved" PointerExited="SeekBarHost_PointerExited">
                                <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0"
                                    VerticalAlignment="Center" IsThumbToolTipEnabled="False" IsEnabled="False"
                                    ValueChanged="SeekSlider_ValueChanged"
                                    PointerPressed="SeekSlider_PointerPressed" PointerReleased="SeekSlider_PointerReleased" />
                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="SeekPreviewBadge" Canvas.Top="-34" Visibility="Collapsed" Padding="8,4"
                                        Background="#F21F1F1F" BorderBrush="#22FFFFFF" BorderThickness="1"
                                        CornerRadius="6">
                                        <TextBlock x:Name="SeekPreviewText" Text="0:00" FontSize="12" Foreground="White" />
                                    </Border>
                                </Canvas>
                            </Grid>

                            <StackPanel x:Name="RightControlsGroup" Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center">
                                <Button x:Name="PlayerSettingsButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    ToolTipService.ToolTip="Playback settings">
                                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                                    <Button.Flyout>
                                        <Flyout Placement="Top">
                                            <Border Background="#F20A0A0A" Padding="16" CornerRadius="8"
                                                    MinWidth="280">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="Playback settings" FontWeight="SemiBold"
                                                               Margin="0,0,0,2" />
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="Audio track" FontSize="12" Opacity="0.72" />
                                                        <ComboBox x:Name="AudioTrackCombo" MinWidth="248"
                                                                  PlaceholderText="No audio tracks"
                                                                  IsEnabled="False"
                                                                  SelectionChanged="AudioTrackCombo_SelectionChanged" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="Subtitles" FontSize="12" Opacity="0.72" />
                                                        <ComboBox x:Name="SubtitleTrackCombo" MinWidth="248"
                                                                  PlaceholderText="No subtitles"
                                                                  IsEnabled="False"
                                                                  SelectionChanged="SubtitleTrackCombo_SelectionChanged" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="Playback speed" FontSize="12" Opacity="0.72" />
                                                        <ComboBox x:Name="PlaybackSpeedCombo" MinWidth="248"
                                                                  SelectedIndex="2"
                                                                  SelectionChanged="PlaybackSpeedCombo_SelectionChanged">
                                                            <ComboBoxItem Content="0.5×" Tag="0.5" />
                                                            <ComboBoxItem Content="0.75×" Tag="0.75" />
                                                            <ComboBoxItem Content="1×" Tag="1" />
                                                            <ComboBoxItem Content="1.25×" Tag="1.25" />
                                                            <ComboBoxItem Content="1.5×" Tag="1.5" />
                                                            <ComboBoxItem Content="2×" Tag="2" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="FullscreenButton" Style="{StaticResource PlayerIconButtonStyle}"
                                    Click="FullscreenButton_Click" ToolTipService.ToolTip="Toggle fullscreen">
                                    <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="DropOverlay" Visibility="Collapsed" Margin="24" CornerRadius="20"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                    Background="#E51A1D29" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE8E5;" FontSize="42" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="Drop a video to play instantly" Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                        <TextBlock Text="It won’t be added to your folders or library."
                               HorizontalAlignment="Center" Opacity="0.72" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </NavigationView>
</Window>

