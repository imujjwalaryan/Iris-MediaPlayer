<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.PlaceholderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="440">
            <TextBlock x:Name="PlaceholderTitle" Text="Coming later" Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="PlaceholderDescription" Text="This area will be built in a later Iris milestone."
                       TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" />
        </StackPanel>
    </Grid>
</UserControl>
