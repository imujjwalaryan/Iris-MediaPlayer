<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Iris_MediaPlayer.Views.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="RowCardTemplate">
            <Button Style="{StaticResource IrisCardButtonStyle}" Width="296"
                    Tag="{Binding FilePath}" Click="MediaCard_Click">
                <controls:MediaCard />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ContinueCardTemplate">
            <Button Style="{StaticResource IrisCardButtonStyle}" Width="296"
                    Tag="{Binding FilePath}" Click="ContinueCard_Click">
                <controls:MediaCard ShowTimeRemaining="True" />
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="36" Padding="0,0,0,40">

            <!-- Hero: full-bleed artwork that fades into the page on the left and bottom -->
            <Grid x:Name="Hero" Height="540" Visibility="Collapsed">
                <Image x:Name="HeroImage" Stretch="UniformToFill"
                       HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F20F1115" Offset="0" />
                            <GradientStop Color="#CC0F1115" Offset="0.3" />
                            <GradientStop Color="#590F1115" Offset="0.6" />
                            <GradientStop Color="#000F1115" Offset="0.85" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#000F1115" Offset="0.4" />
                            <GradientStop Color="#990F1115" Offset="0.75" />
                            <GradientStop Color="#FF0F1115" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="640"
                            Margin="40,0,32,12" Spacing="12">
                    <TextBlock x:Name="HeroEyebrow" Style="{StaticResource IrisEyebrowTextStyle}" />
                    <TextBlock x:Name="HeroTitle" FontSize="40" FontWeight="SemiBold" LineHeight="48"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HeroMeta" Style="{StaticResource IrisBodySecondaryTextStyle}" />
                    <StackPanel x:Name="HeroProgressPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                        <ProgressBar x:Name="HeroProgress" Width="220" Maximum="1" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeroRemaining" Style="{StaticResource IrisCaptionTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                        <Button x:Name="HeroPlayButton" Style="{StaticResource AccentButtonStyle}"
                                Click="HeroPlay_Click" Padding="20,9">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock x:Name="HeroPlayText" Text="Play" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Click="BrowseLibrary_Click" Padding="20,9">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                <TextBlock Text="Browse library" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- First run / empty library -->
            <controls:EmptyState x:Name="WelcomeState" Visibility="Collapsed" Margin="0,140,0,0"
                                 ActionClick="WelcomeAction_Click" SecondaryActionClick="WelcomeSecondaryAction_Click" />

            <!-- Continue watching -->
            <StackPanel x:Name="ContinueSection" Spacing="8" Visibility="Collapsed">
                <Grid Margin="40,0,32,0">
                    <TextBlock Text="Continue watching" Style="{StaticResource IrisSectionTitleTextStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                        <Button Style="{StaticResource IrisSubtleIconButtonStyle}" Tag="ContinueScroller" Click="ScrollRowBack_Click"
                                ToolTipService.ToolTip="Scroll left">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource IrisSubtleIconButtonStyle}" Tag="ContinueScroller" Click="ScrollRowForward_Click"
                                ToolTipService.ToolTip="Scroll right">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="ContinueScroller" Padding="32,0" HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsRepeater x:Name="ContinueItems" ItemTemplate="{StaticResource ContinueCardTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>

            <!-- Recently added -->
            <StackPanel x:Name="AddedSection" Spacing="8" Visibility="Collapsed">
                <Grid Margin="40,0,32,0">
                    <TextBlock Text="Recently added" Style="{StaticResource IrisSectionTitleTextStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                        <Button Style="{StaticResource IrisSubtleIconButtonStyle}" Tag="AddedScroller" Click="ScrollRowBack_Click"
                                ToolTipService.ToolTip="Scroll left">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource IrisSubtleIconButtonStyle}" Tag="AddedScroller" Click="ScrollRowForward_Click"
                                ToolTipService.ToolTip="Scroll right">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="AddedScroller" Padding="32,0" HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsRepeater x:Name="AddedItems" ItemTemplate="{StaticResource RowCardTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>

            <!-- Recently played -->
            <StackPanel x:Name="RecentSection" Spacing="8" Visibility="Collapsed">
                <Grid Margin="40,0,32,0">
                    <TextBlock Text="Recently played" Style="{StaticResource IrisSectionTitleTextStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                        <Button Style="{StaticResource IrisSubtleIconButtonStyle}" Tag="RecentScroller" Click="ScrollRowBack_Click"
                                ToolTipService.ToolTip="Scroll left">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource IrisSubtleIconButtonStyle}" Tag="RecentScroller" Click="ScrollRowForward_Click"
                                ToolTipService.ToolTip="Scroll right">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="RecentScroller" Padding="32,0" HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsRepeater x:Name="RecentItems" ItemTemplate="{StaticResource RowCardTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
