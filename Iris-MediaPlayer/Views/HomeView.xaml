<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="22" Padding="28,24,28,32">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Home" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="PageSubtitle" Text="Welcome to Iris — your media, gathered in one place." Opacity="0.72" />
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="1" Width="300" PlaceholderText="Search your library"
                         VerticalAlignment="Center" TextChanged="SearchBox_TextChanged">
                    <TextBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </TextBox.KeyboardAccelerators>
                </TextBox>
                <Button Grid.Column="2" Content="Open video" Click="OpenVideo_Click" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="Add folder" Click="AddFolder_Click" VerticalAlignment="Center" />
            </Grid>

            <Border x:Name="UpNextCard" Height="280" CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52*" />
                        <ColumnDefinition Width="48*" />
                    </Grid.ColumnDefinitions>
                    <!-- DataContext is the featured MediaItem, so the thumbnail appears as soon as it loads. -->
                    <Image x:Name="FeaturedImage" Grid.Column="0" Source="{Binding Thumbnail}"
                           Stretch="UniformToFill" Opacity="0.4"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <Border Grid.ColumnSpan="2" CornerRadius="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#80392F54" Offset="0" />
                                <GradientStop Color="#70202433" Offset="0.48" />
                                <GradientStop Color="#80171A23" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Grid.ColumnSpan="2" Padding="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="12" MaxWidth="540">
                            <TextBlock Text="UP NEXT" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       FontWeight="SemiBold" CharacterSpacing="160" />
                            <TextBlock x:Name="FeaturedTitle" Text="Your next favorite starts here"
                                       Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="FeaturedSubtitle"
                                       Text="Add a folder and Iris will discover your movies and shows."
                                       TextWrapping="Wrap" Opacity="0.78" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                <Button x:Name="FeaturedPlayButton" Content="Play" Click="FeaturedPlay_Click"
                                        IsEnabled="False" />
                                <Button Content="Browse library" Click="LibraryShortcut_Click" />
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Column="1" />
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Continue watching" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ContinueEmpty" Grid.Column="1"
                               Text="Playback progress will be added next" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Opacity="0.62" />
                </Grid>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ContinueItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding FilePath}" Click="MediaCard_Click" Padding="0" BorderThickness="0"
                                        Background="Transparent" Width="220" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="7">
                                        <Border Height="120" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE714;" FontSize="30" Opacity="0.35" />
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                <Border VerticalAlignment="Bottom" Padding="12" Background="#B8000000">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="10">
                    <TextBlock Text="Recently played" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="RecentlyPlayedEmpty"
                               Text="Nothing played yet. Play a title from your library and it will appear here."
                               TextWrapping="Wrap" Opacity="0.7" />
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RecentItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding FilePath}" Click="MediaCard_Click" Padding="0" BorderThickness="0"
                                            Background="Transparent" Width="112">
                                        <StackPanel Spacing="6">
                                            <Border Height="120" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE714;" FontSize="24" Opacity="0.35" />
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    <Border VerticalAlignment="Bottom" Padding="8" Background="#B8000000">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.68" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10">
                    <Grid>
                        <TextBlock Text="Your folders" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button Content="Add" Click="AddFolder_Click" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView x:Name="FolderList" MaxHeight="180" SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MediaCountLabel}" FontSize="12" Opacity="0.65" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="&#xE74D;" Tag="{Binding Path}"
                                            Click="RemoveFolder_Click" ToolTipService.ToolTip="Remove folder" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="FoldersEmpty" Text="Add folders to build your library."
                               Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Padding="14,10" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Drop a video anywhere in Iris or choose Open video for instant playback."
                               VerticalAlignment="Center" Opacity="0.72" />
                    <Button Grid.Column="1" Content="Open video" Click="OpenVideo_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
