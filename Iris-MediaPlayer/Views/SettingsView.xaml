<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same header as Library. The sections are built in code (SettingsView.xaml.cs) from a few row helpers. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="48,32,40,0" Spacing="6">
            <TextBlock Text="Settings" Style="{StaticResource IrisPageTitleTextStyle}" />
            <TextBlock Text="Changes are saved straight away." Style="{StaticResource IrisBodySecondaryTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="Sections" Margin="48,0,40,40" Spacing="8" MaxWidth="820" HorizontalAlignment="Left" />
        </ScrollViewer>
    </Grid>
</UserControl>
