<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        One centred column: the header and the sections share the same width, so the title lines up
        with the cards on any window size. The sections are built in code (SettingsView.xaml.cs).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="40,32,40,0" Spacing="6" MaxWidth="860" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource IrisPageTitleTextStyle}" />
            <TextBlock Text="Changes are saved straight away." Style="{StaticResource IrisBodySecondaryTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="Sections" Margin="40,0,40,40" Spacing="8" MaxWidth="860" HorizontalAlignment="Stretch" />
        </ScrollViewer>
    </Grid>
</UserControl>
