<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.JellyfinView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Iris_MediaPlayer.Views.Controls">

    <UserControl.Resources>
        <!-- Tall poster: films, shows, seasons, folders. The art keeps a 2:3 shape (PosterArt_SizeChanged). -->
        <DataTemplate x:Key="PosterTemplate">
            <Button Style="{StaticResource IrisCardButtonStyle}" Tag="{Binding}" Click="Item_Click" Padding="6">
                <StackPanel Spacing="10">
                    <Grid CornerRadius="10" Background="{StaticResource IrisThumbnailBrush}" Tag="1.5"
                          SizeChanged="Art_SizeChanged">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="30" Opacity="0.3" />
                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                        <ProgressBar VerticalAlignment="Bottom" Margin="10,0,10,10" Maximum="1" Value="{Binding Progress}"
                                     Visibility="{Binding ProgressVisibility}" />
                    </Grid>
                    <StackPanel Spacing="2" Margin="2,0">
                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource IrisCaptionTextStyle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Wide still: episodes and other videos, 16:9. -->
        <DataTemplate x:Key="WideTemplate">
            <Button Style="{StaticResource IrisCardButtonStyle}" Tag="{Binding}" Click="Item_Click" Padding="6">
                <StackPanel Spacing="10">
                    <Grid CornerRadius="10" Background="{StaticResource IrisThumbnailBrush}" Tag="0.5625"
                          SizeChanged="Art_SizeChanged">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="30" Opacity="0.3" />
                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                        <ProgressBar VerticalAlignment="Bottom" Margin="10,0,10,10" Maximum="1" Value="{Binding Progress}"
                                     Visibility="{Binding ProgressVisibility}" />
                    </Grid>
                    <StackPanel Spacing="2" Margin="2,0">
                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource IrisCaptionTextStyle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: server name and who is signed in -->
        <Grid Margin="48,32,40,0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6" VerticalAlignment="Bottom">
                <TextBlock x:Name="PageTitle" Text="Jellyfin" Style="{StaticResource IrisPageTitleTextStyle}" />
                <TextBlock x:Name="PageSummary" Style="{StaticResource IrisBodySecondaryTextStyle}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" Text="Stream from your Jellyfin server." />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IrisOutlineButtonStyle}" VerticalAlignment="Bottom"
                    Click="Refresh_Click" Visibility="Collapsed" ToolTipService.ToolTip="Load again from the server">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Libraries, then where you are inside one -->
        <Grid x:Name="BrowseBar" Grid.Row="1" Margin="48,22,40,14" ColumnSpacing="16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:Segmented x:Name="LibraryTabs" SelectionChanged="LibraryTabs_SelectionChanged"
                                AutomationProperties.Name="Jellyfin libraries" />
            <BreadcrumbBar x:Name="Breadcrumb" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                           ItemClicked="Breadcrumb_ItemClicked" />
        </Grid>

        <!-- Browsing -->
        <Grid x:Name="BrowsePanel" Grid.Row="2" Visibility="Collapsed">
            <ScrollViewer x:Name="ItemsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <Grid Padding="42,0,34,32">
                    <ItemsRepeater x:Name="PosterItems" ItemTemplate="{StaticResource PosterTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="168" ItemsStretch="Fill" MinColumnSpacing="4" MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <ItemsRepeater x:Name="WideItems" ItemTemplate="{StaticResource WideTemplate}" Visibility="Collapsed">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="264" ItemsStretch="Fill" MinColumnSpacing="4" MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>
            </ScrollViewer>
            <ProgressRing x:Name="LoadingRing" Width="36" Height="36" IsActive="False" VerticalAlignment="Top" Margin="0,80,0,0" />
            <controls:EmptyState x:Name="BrowseMessage" Visibility="Collapsed" Margin="0,40,0,80" ActionClick="BrowseMessage_ActionClick" />
        </Grid>

        <!-- Connecting and signing in: one centred card that changes step by step -->
        <ScrollViewer x:Name="SignInPanel" Grid.Row="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Border MaxWidth="460" Margin="40,48,40,40" Padding="32,28" CornerRadius="18" VerticalAlignment="Top"
                    Background="{StaticResource IrisSurfaceBrush}" BorderBrush="{StaticResource IrisStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="StepTitle" Text="Connect to your server" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="StepCaption" Style="{StaticResource IrisBodySecondaryTextStyle}" TextWrapping="Wrap"
                                   Text="Type the address you use to open Jellyfin in a browser." />
                    </StackPanel>

                    <!-- Step 1: address -->
                    <StackPanel x:Name="AddressStep" Spacing="14">
                        <TextBox x:Name="AddressBox" Header="Server address" PlaceholderText="http://192.168.1.10:8096"
                                 CornerRadius="10" KeyDown="AddressBox_KeyDown" IsSpellCheckEnabled="False" />
                        <Button x:Name="ConnectButton" Style="{StaticResource IrisPrimaryButtonStyle}" HorizontalAlignment="Stretch"
                                Content="Connect" Click="Connect_Click" />
                    </StackPanel>

                    <!-- Step 2: sign in -->
                    <StackPanel x:Name="SignInStep" Spacing="14" Visibility="Collapsed">
                        <TextBox x:Name="UserNameBox" Header="Username" CornerRadius="10" IsSpellCheckEnabled="False" />
                        <PasswordBox x:Name="PasswordBox" Header="Password" CornerRadius="10" KeyDown="PasswordBox_KeyDown" />
                        <Button x:Name="SignInButton" Style="{StaticResource IrisPrimaryButtonStyle}" HorizontalAlignment="Stretch"
                                Content="Sign in" Click="SignIn_Click" />
                        <Button x:Name="QuickConnectButton" Style="{StaticResource IrisOutlineButtonStyle}" HorizontalAlignment="Stretch"
                                Click="QuickConnect_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8D7;" FontSize="13" />
                                <TextBlock Text="Use Quick Connect instead" />
                            </StackPanel>
                        </Button>
                        <HyperlinkButton Content="Use a different server" Click="ChangeServer_Click" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Step 2b: Quick Connect code -->
                    <StackPanel x:Name="QuickConnectStep" Spacing="14" Visibility="Collapsed">
                        <Border CornerRadius="14" Padding="0,18" Background="{StaticResource IrisRaisedBrush}">
                            <TextBlock x:Name="QuickConnectCode" FontSize="40" FontWeight="SemiBold" CharacterSpacing="300"
                                       HorizontalAlignment="Center" IsTextSelectionEnabled="True" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <ProgressRing Width="16" Height="16" IsActive="True" />
                            <TextBlock Text="Waiting for approval…" Style="{StaticResource IrisBodySecondaryTextStyle}" />
                        </StackPanel>
                        <Button Style="{StaticResource IrisOutlineButtonStyle}" HorizontalAlignment="Stretch"
                                Content="Cancel" Click="CancelQuickConnect_Click" />
                    </StackPanel>

                    <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" IsOpen="False" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
