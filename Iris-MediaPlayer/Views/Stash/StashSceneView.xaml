<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.Stash.StashSceneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Iris_MediaPlayer.Views.Controls">

    <UserControl.Resources>
        <!-- A performer: round photo (or the first letter) and name. Opens their scenes. -->
        <DataTemplate x:Key="PerformerTemplate">
            <Button Style="{StaticResource IrisCardButtonStyle}" Width="124" Padding="6" Tag="{Binding}" Click="Performer_Click">
                <StackPanel Spacing="8">
                    <Grid Width="96" Height="96" CornerRadius="48" HorizontalAlignment="Center" Background="{StaticResource IrisRaisedBrush}"
                          BorderBrush="{StaticResource IrisStrokeBrush}" BorderThickness="1">
                        <FontIcon Glyph="&#xE77B;" FontSize="28" Opacity="0.35" />
                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- A marker: the time and its title. Plays the scene from there. -->
        <DataTemplate x:Key="MarkerTemplate">
            <Button Style="{StaticResource IrisCardButtonStyle}" Padding="12,10" Tag="{Binding}" Click="Marker_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Padding="10,4" CornerRadius="12" Background="{StaticResource IrisAccentSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Time}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource IrisAccentLightBrush}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <Grid>
                <Grid x:Name="Backdrop" Height="640" VerticalAlignment="Top" SizeChanged="Backdrop_SizeChanged">
                    <Image x:Name="BackdropImage" Stretch="UniformToFill" SizeChanged="BackdropImage_SizeChanged" />
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F209090B" Offset="0" />
                                <GradientStop Color="#C009090B" Offset="0.4" />
                                <GradientStop Color="#2609090B" Offset="0.75" />
                                <GradientStop Color="#0D09090B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#8009090B" Offset="0" />
                                <GradientStop Color="#0009090B" Offset="0.2" />
                                <GradientStop Color="#2909090B" Offset="0.55" />
                                <GradientStop Color="#FF09090B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel x:Name="Body" Margin="56,250,48,48" Spacing="34" Visibility="Collapsed">
                    <StackPanel x:Name="Header" Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
                        <HyperlinkButton x:Name="StudioLink" Padding="0" Click="Studio_Click">
                            <TextBlock x:Name="StudioText" Style="{StaticResource IrisEyebrowTextStyle}" />
                        </HyperlinkButton>
                        <TextBlock x:Name="TitleText" Style="{StaticResource IrisDisplayTextStyle}" TextWrapping="Wrap" MaxLines="3"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="MetaPanel" Orientation="Horizontal" Spacing="12" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button Style="{StaticResource IrisPrimaryButtonStyle}" Click="Play_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                    <TextBlock x:Name="PlayText" Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StartOverButton" Style="{StaticResource IrisGhostButtonStyle}" Click="StartOver_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Start over" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Spacing="12">
                            <Grid Width="300" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="#29FFFFFF">
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource IrisAccentBrush}" />
                            </Grid>
                            <TextBlock x:Name="RemainingText" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource IrisTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="DetailsText" FontSize="15" LineHeight="24" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left"
                                   Foreground="{StaticResource IrisTextMutedBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="PerformersSection" Spacing="12">
                        <TextBlock Text="Performers" Style="{StaticResource IrisSectionTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"
                                      Margin="-6,0,0,0" Padding="0,0,0,10">
                            <ItemsRepeater x:Name="PerformerItems" ItemTemplate="{StaticResource PerformerTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel x:Name="TagsSection" Spacing="12">
                        <TextBlock Text="Tags" Style="{StaticResource IrisSectionTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" Padding="0,0,0,10">
                            <StackPanel x:Name="TagPanel" Orientation="Horizontal" Spacing="8" />
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel x:Name="MarkersSection" Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Markers" Style="{StaticResource IrisSectionTitleTextStyle}" />
                        <ItemsRepeater x:Name="MarkerItems" ItemTemplate="{StaticResource MarkerTemplate}" Margin="-12,0,0,0">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="2" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="File" Style="{StaticResource IrisSectionTitleTextStyle}" />
                        <StackPanel x:Name="FilePanel" Orientation="Horizontal" Spacing="36" />
                        <TextBlock x:Name="PathText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{StaticResource IrisTextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingRing" Width="40" Height="40" IsActive="False" />
        <controls:EmptyState x:Name="Message" Visibility="Collapsed" Margin="0,40,0,80" ActionClick="Message_ActionClick" />
    </Grid>
</UserControl>
