<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.Controls.TileCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Card_SizeChanged"
    PointerEntered="Card_PointerEntered"
    PointerExited="Card_PointerExited"
    PointerCanceled="Card_PointerExited">

    <UserControl.Resources>
        <Style x:Key="PrintStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Background" Value="{StaticResource IrisRaisedBrush}" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <!--
        Folder / collection card. DataContext is a LibraryTile.
        Folders: three thumbnails stacked like prints that fan out on hover.
        Collections: a 2 × 2 mosaic that zooms slightly on hover.
    -->
    <StackPanel Spacing="14">
        <Grid x:Name="ArtArea" Height="150">
            <Border x:Name="EmptyArt" CornerRadius="12" Background="{StaticResource IrisRaisedBrush}" Visibility="Collapsed">
                <FontIcon x:Name="EmptyGlyph" FontSize="30" Opacity="0.35" />
            </Border>

            <Grid x:Name="StackArt">
                <Border x:Name="Print1" Style="{StaticResource PrintStyle}">
                    <Image x:Name="Print1Image" Stretch="UniformToFill" />
                </Border>
                <Border x:Name="Print2" Style="{StaticResource PrintStyle}">
                    <Image x:Name="Print2Image" Stretch="UniformToFill" />
                </Border>
                <Border x:Name="Print3" Style="{StaticResource PrintStyle}">
                    <Image x:Name="Print3Image" Stretch="UniformToFill" />
                </Border>
            </Grid>

            <Grid x:Name="MosaicArt" CornerRadius="12" RowSpacing="4" ColumnSpacing="4" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid Background="{StaticResource IrisRaisedBrush}">
                    <Image x:Name="Mosaic1" Stretch="UniformToFill" />
                </Grid>
                <Grid Grid.Column="1" Background="{StaticResource IrisRaisedBrush}">
                    <Image x:Name="Mosaic2" Stretch="UniformToFill" />
                </Grid>
                <Grid Grid.Row="1" Background="{StaticResource IrisRaisedBrush}">
                    <Image x:Name="Mosaic3" Stretch="UniformToFill" />
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource IrisRaisedBrush}">
                    <Image x:Name="Mosaic4" Stretch="UniformToFill" />
                </Grid>
            </Grid>
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="GlyphChip" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center"
                    Background="{StaticResource IrisAccentSoftBrush}">
                <FontIcon x:Name="TileGlyph" FontSize="17" Foreground="{StaticResource IrisAccentLightBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock x:Name="DetailText" Style="{StaticResource IrisCaptionTextStyle}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
        </Grid>
    </StackPanel>

</UserControl>
