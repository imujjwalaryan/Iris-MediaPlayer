<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Iris_MediaPlayer.Views.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="VideoCardTemplate">
            <Button Style="{StaticResource IrisCardButtonStyle}" Tag="{Binding FilePath}" Click="MediaCard_Click">
                <controls:MediaCard />
            </Button>
        </DataTemplate>

        <!-- Folder and collection cards. The menu is built per card in code (TileMore_Click / Tile_ContextRequested). -->
        <DataTemplate x:Key="TileTemplate">
            <Grid>
                <Button Style="{StaticResource IrisCardButtonStyle}" Tag="{Binding}" Click="Tile_Click"
                        ContextRequested="Tile_ContextRequested">
                    <controls:TileCard />
                </Button>
                <Button Style="{StaticResource IrisOverflowButtonStyle}" Click="TileMore_Click"
                        ToolTipService.ToolTip="More options">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Top padding leaves room for the app's floating top bar. -->
    <Grid Padding="0,76,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, summary and this page's own actions -->
        <Grid Margin="40,0,32,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="PageTitle" Text="Videos" Style="{StaticResource IrisPageTitleTextStyle}" />
                <TextBlock x:Name="PageSummary" Style="{StaticResource IrisBodySecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel x:Name="SortPanel" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Sort by" VerticalAlignment="Center" Style="{StaticResource IrisBodySecondaryTextStyle}" />
                    <ComboBox x:Name="SortCombo" MinWidth="170" SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="Name" Tag="Name" />
                        <ComboBoxItem Content="Recently added" Tag="Added" />
                        <ComboBoxItem Content="Folder" Tag="Folder" />
                    </ComboBox>
                </StackPanel>
                <Button x:Name="AddFolderButton" Click="AddFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add folder" />
                    </StackPanel>
                </Button>
                <Button x:Name="NewCollectionButton" Click="CreateCollection_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New collection" />
                    </StackPanel>
                </Button>
                <Button x:Name="EditCollectionButton" Click="EditCollectionVideos_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        <TextBlock Text="Edit videos" />
                    </StackPanel>
                </Button>
                <Button x:Name="CollectionMoreButton" Click="CollectionMore_Click"
                        ToolTipService.ToolTip="More options" Padding="10,8">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <BreadcrumbBar x:Name="Breadcrumb" Grid.Row="1" Margin="40,14,32,0" Visibility="Collapsed"
                       ItemClicked="Breadcrumb_ItemClicked" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel Spacing="20" Padding="32,0,32,32">
                    <StackPanel x:Name="TilesSection" Spacing="6">
                        <TextBlock x:Name="TilesHeader" Text="Folders" Margin="8,0" Style="{StaticResource IrisSectionTitleTextStyle}" />
                        <ItemsRepeater x:Name="FolderTileItems" ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="248" ItemsStretch="Fill" MinColumnSpacing="4" MinRowSpacing="4" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <ItemsRepeater x:Name="CollectionTileItems" ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="248" ItemsStretch="Fill" MinColumnSpacing="4" MinRowSpacing="4" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel x:Name="VideosSection" Spacing="6">
                        <TextBlock x:Name="VideosHeader" Text="Videos" Margin="8,0" Style="{StaticResource IrisSectionTitleTextStyle}" />
                        <ItemsRepeater x:Name="VideoItems" ItemTemplate="{StaticResource VideoCardTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="264" ItemsStretch="Fill" MinColumnSpacing="4" MinRowSpacing="4" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <controls:EmptyState x:Name="EmptyMessage" Visibility="Collapsed" Margin="0,0,0,80"
                                 ActionClick="EmptyMessage_ActionClick" />
        </Grid>
    </Grid>
</UserControl>
