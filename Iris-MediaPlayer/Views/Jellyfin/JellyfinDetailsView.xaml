<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Iris_MediaPlayer.Views.Jellyfin.JellyfinDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Iris_MediaPlayer.Views.Controls">

    <UserControl.Resources>
        <!-- One episode in a season: still, number, title, overview, length and air date. -->
        <DataTemplate x:Key="EpisodeTemplate">
            <Button Style="{StaticResource IrisCardButtonStyle}" Padding="10" Tag="{Binding}" Click="Episode_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="228" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Height="128" CornerRadius="12" Background="{StaticResource IrisThumbnailBrush}">
                        <FontIcon Glyph="&#xE714;" FontSize="26" Opacity="0.3" />
                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                        <Border Width="24" Height="24" CornerRadius="12" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#BF09090B" Visibility="{Binding PlayedVisibility}">
                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource IrisAccentLightBrush}" />
                        </Border>
                        <ProgressBar VerticalAlignment="Bottom" Maximum="1" Value="{Binding Progress}" MinHeight="4"
                                     Visibility="{Binding ProgressVisibility}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding EpisodeLabel}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{StaticResource IrisAccentTextBrush}" />
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding Overview}" FontSize="13" LineHeight="20" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="WordEllipsis" MaxWidth="820" HorizontalAlignment="Left"
                                   Foreground="{StaticResource IrisTextSecondaryBrush}" />
                        <TextBlock Text="{Binding EpisodeInfo}" FontSize="12" Foreground="{StaticResource IrisTextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- One person in the cast row: round photo (or initial), name, part. -->
        <DataTemplate x:Key="PersonTemplate">
            <StackPanel Width="116" Spacing="8">
                <Grid Width="92" Height="92" CornerRadius="46" HorizontalAlignment="Center" Background="{StaticResource IrisRaisedBrush}"
                      BorderBrush="{StaticResource IrisStrokeBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding Initial}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource IrisTextTertiaryBrush}" />
                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Role}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource IrisTextTertiaryBrush}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <Grid>
                <!-- Backdrop with a slow drift, faded into the page -->
                <Grid x:Name="Backdrop" Height="640" VerticalAlignment="Top" SizeChanged="Backdrop_SizeChanged">
                    <Image x:Name="BackdropImage" Stretch="UniformToFill" SizeChanged="BackdropImage_SizeChanged" />
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F709090B" Offset="0" />
                                <GradientStop Color="#D909090B" Offset="0.38" />
                                <GradientStop Color="#4009090B" Offset="0.72" />
                                <GradientStop Color="#1A09090B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#8009090B" Offset="0" />
                                <GradientStop Color="#0009090B" Offset="0.18" />
                                <GradientStop Color="#0009090B" Offset="0.5" />
                                <GradientStop Color="#FF09090B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel x:Name="Body" Margin="56,92,48,48" Spacing="36" Visibility="Collapsed">
                    <Grid ColumnSpacing="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="248" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Poster and quality badges -->
                        <StackPanel x:Name="PosterColumn" Spacing="14" VerticalAlignment="Top">
                            <Grid Height="372" CornerRadius="16" Background="{StaticResource IrisThumbnailBrush}"
                                  BorderBrush="{StaticResource IrisStrokeStrongBrush}" BorderThickness="1">
                                <FontIcon x:Name="PosterGlyph" Glyph="&#xE8B2;" FontSize="34" Opacity="0.3" />
                                <Image x:Name="PosterImage" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel x:Name="Badges" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="Info" Grid.Column="1" Spacing="14" Padding="0,12,0,0">
                            <Grid>
                                <Image x:Name="LogoImage" MaxHeight="130" MaxWidth="520" HorizontalAlignment="Left" Stretch="Uniform" />
                                <TextBlock x:Name="TitleText" Style="{StaticResource IrisDisplayTextStyle}" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock x:Name="TaglineText" FontSize="16" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{StaticResource IrisTextMutedBrush}" />
                            <StackPanel x:Name="MetaPanel" Orientation="Horizontal" Spacing="12" />
                            <StackPanel x:Name="GenrePanel" Orientation="Horizontal" Spacing="8" />

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Button x:Name="PlayButton" Style="{StaticResource IrisPrimaryButtonStyle}" Click="Play_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                        <TextBlock x:Name="PlayText" Text="Play" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StartOverButton" Style="{StaticResource IrisGhostButtonStyle}" Click="StartOver_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        <TextBlock Text="Start over" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TrailerButton" Style="{StaticResource IrisRoundGhostButtonStyle}" Click="Trailer_Click"
                                        ToolTipService.ToolTip="Watch the trailer" AutomationProperties.Name="Watch the trailer">
                                    <FontIcon Glyph="&#xE8B2;" FontSize="16" />
                                </Button>
                                <Button x:Name="WatchedButton" Style="{StaticResource IrisRoundGhostButtonStyle}" Click="Watched_Click"
                                        AutomationProperties.Name="Mark as watched">
                                    <FontIcon x:Name="WatchedGlyph" Glyph="&#xE73E;" FontSize="16" />
                                </Button>
                                <Button x:Name="FavoriteButton" Style="{StaticResource IrisRoundGhostButtonStyle}" Click="Favorite_Click"
                                        AutomationProperties.Name="Favorite">
                                    <FontIcon x:Name="FavoriteGlyph" Glyph="&#xEB51;" FontSize="16" />
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Spacing="12">
                                <Grid Width="300" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="#29FFFFFF">
                                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource IrisAccentBrush}" />
                                </Grid>
                                <TextBlock x:Name="RemainingText" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource IrisTextSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock x:Name="OverviewText" FontSize="15" LineHeight="24" TextWrapping="Wrap" MaxWidth="760"
                                       HorizontalAlignment="Left" Foreground="{StaticResource IrisTextMutedBrush}" />

                            <!-- What to play: version, audio and subtitles -->
                            <Grid x:Name="Pickers" ColumnSpacing="10" MaxWidth="860" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="VersionPicker" Spacing="6">
                                    <TextBlock Text="VERSION" Style="{StaticResource IrisEyebrowTextStyle}" Foreground="{StaticResource IrisTextTertiaryBrush}" />
                                    <ComboBox x:Name="VersionBox" HorizontalAlignment="Stretch" CornerRadius="10" SelectionChanged="Version_SelectionChanged"
                                              AutomationProperties.Name="Version" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="AUDIO" Style="{StaticResource IrisEyebrowTextStyle}" Foreground="{StaticResource IrisTextTertiaryBrush}" />
                                    <ComboBox x:Name="AudioBox" HorizontalAlignment="Stretch" CornerRadius="10" SelectionChanged="Audio_SelectionChanged"
                                              AutomationProperties.Name="Audio" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="SUBTITLES" Style="{StaticResource IrisEyebrowTextStyle}" Foreground="{StaticResource IrisTextTertiaryBrush}" />
                                    <ComboBox x:Name="SubtitleBox" HorizontalAlignment="Stretch" CornerRadius="10" SelectionChanged="Subtitle_SelectionChanged"
                                              AutomationProperties.Name="Subtitles" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="Credits" Orientation="Horizontal" Spacing="36" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Shows: seasons and their episodes -->
                    <StackPanel x:Name="EpisodesSection" Spacing="14" Visibility="Collapsed">
                        <Grid>
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                                          HorizontalAlignment="Left" MaxWidth="900">
                                <controls:Segmented x:Name="SeasonTabs" SegmentWidth="112" IsPill="True" SegmentHeight="34"
                                                    SelectionChanged="SeasonTabs_SelectionChanged" AutomationProperties.Name="Seasons" />
                            </ScrollViewer>
                            <TextBlock x:Name="SeasonSummary" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource IrisTextTertiaryBrush}" />
                        </Grid>
                        <Grid>
                            <ItemsRepeater x:Name="EpisodeItems" ItemTemplate="{StaticResource EpisodeTemplate}" Margin="-10,0,-10,0"
                                           ElementPrepared="Episodes_ElementPrepared">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="2" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <ProgressRing x:Name="EpisodesRing" Width="28" Height="28" IsActive="False" VerticalAlignment="Top" Margin="0,24,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Cast -->
                    <StackPanel x:Name="CastSection" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Cast" Style="{StaticResource IrisSectionTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" Margin="-8,0,0,0"
                                      Padding="0,0,0,12">
                            <ItemsRepeater x:Name="CastItems" ItemTemplate="{StaticResource PersonTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingRing" Width="40" Height="40" IsActive="False" />
        <controls:EmptyState x:Name="Message" Visibility="Collapsed" Margin="0,40,0,80" ActionClick="Message_ActionClick" />
    </Grid>
</UserControl>
